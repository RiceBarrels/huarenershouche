{
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/i18n/drain",
      "schedule": "*/2 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/zh",
      "permanent": false
    },
    {
      "source": "/((?!zh(?:/|$)|en(?:/|$)|ko(?:/|$)|ja(?:/|$)|es(?:/|$)|fr(?:/|$)|api/|_next/|.*\\..*).+)",
      "destination": "/zh/$1",
      "permanent": true
    }
  ]
}
